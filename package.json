{
  "name": "fcr-scs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema=data_layer/database/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=data_layer/database/prisma/schema.prisma",
    "db:seed": "cd data_layer/database && npx ts-node seed.ts",
    "dev:backend": "cd business_logic_layer && npm run dev",
    "dev:frontend": "cd presentation_layer && npm run dev",
    "ai:venv": "python -m venv business_logic_layer/ai_prediction_service/.venv",
    "ai:install": "node scripts/dev-ai.mjs --install",
    "ai:dataset": "node scripts/dev-ai.mjs --dataset",
    "ai:train": "node scripts/dev-ai.mjs --train",
    "dev:ai": "node scripts/dev-ai.mjs",
    "dev": "concurrently -n backend,frontend,ai \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ai\"",
    "build": "npm run build --workspace=presentation_layer"
  },
  "workspaces": [
    "presentation_layer",
    "business_logic_layer",
    "business_logic_layer/*",
    "data_layer/*"
  ],
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}