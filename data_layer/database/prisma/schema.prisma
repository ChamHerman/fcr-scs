generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  CASE_REGISTERED
  VALUER_ASSIGNED
  VALUATION_IN_PROGRESS
  PENDING_VALUATION_APPROVAL
  VALUATION_APPROVED
  VALUATION_REJECTED
  PENDING_COMPENSATION_APPROVAL
  COMPENSATION_APPROVED
  COMPENSATION_REJECTED
  OFFER_ISSUED
  OFFER_REJECTED
  OFFER_ACCEPTED
  PAYMENT_IN_PROGRESS
  PAYMENT_COMPLETED
  CASE_CLOSED
}

enum OfferStatus {
  EXPIRED
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ObjectionStatus {
  APPROVED
  PENDING
  REJECTED
}

enum Decision {
  ACCEPTED
  REJECTED
  REVISED
}

enum UserRole {
  SYSTEM_ADMINISTRATOR
  GOVERNMENT_ADMINISTRATOR
  GOVERNMENT_OFFICER
  LAND_VALUER
  DISPLACED_COMMUNITY_MEMBER
}

model RolePermission {
  id        String   @id @default(uuid())
  role      UserRole
  pagePath  String   @map("page_path")
  canAccess Boolean  @default(true) @map("can_access")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role, pagePath])
  @@map("role_permission")
}

enum AreaUnit {
  SQUARE_METER
  ACRE
  HECTARE
}


enum AlertChannel {
  IN_APP
  EMAIL
  DASHBOARD
}

enum AlertUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeadlineStatus {
  PENDING
  APPROACHING
  EXCEEDED
  COMPLETED
}

enum LogType {
  COMPLIANCE
  BACKUP
}

enum PaymentStatus {
  BANK_DETAILS_PENDING
  READY_TO_INITIATE
  PENDING_APPROVAL
  BANK_APPROVAL_PENDING
  TRANSFER_SUCCEED
  TRANSFER_REJECTED
  TRANSFER_FAILED
  DISPUTED
  PAID
  CANCELLED
  SCHEDULED
  NEW_BANK_DETAILS_PENDING
  AWARD_NOTARIZATION_PENDING
  BANK_DETAILS_AND_M1_PENDING
}

enum BlockchainStatus {
  READY_TO_PUBLISH
  PUBLISHED
  VOID_PENDING
  VOIDED
  REPLACEMENT
}

// id is a short human-readable record id (FCR-XXXXXXXX), assigned by the application
// Dual-milestone notarization (FR-019): one case carries up to two records —
// Milestone 1 (AWARD, Form H hash) and Milestone 2 (SETTLEMENT, receipt hash).
model BlockchainRecord {
  id                  String           @id
  caseId              String
  milestone           String           @default("AWARD")
  onChainKey          String?          @unique
  transactionHash     String?
  documentHash        String
  status              BlockchainStatus @default(PUBLISHED)
  voidReason          String?
  voidTransactionHash String?
  publishedAt         DateTime         @default(now())
  voidedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?        @map("deleted_at")

  @@unique([caseId, milestone])
  @@map("blockchain_record")
}

// id is a short human-readable payment id (PMT-XXXXXXXX), assigned by the application
model PaymentCase {
  id                   String                 @id
  caseId               String                 @unique
  beneficiaryId        String
  amount               Decimal
  bankName             String?
  accountNumber        String?
  accountHolderName    String?
  phoneNumber          String?
  encryptedBankDetails String?
  myKadNumber          String?
  status               PaymentStatus          @default(BANK_DETAILS_PENDING)
  requiredSignatures   Int                    @default(1)
  currentSignatures     Int                    @default(0)
  // Multi-sig cycle (FR-020): incremented when bank details are replaced after
  // a rejection — prior-cycle signatures stay in history but authorize nothing.
  cycle                 Int                    @default(1)
  disputeDocumentPath  String?                @map("dispute_document_path")
  disputeDocumentName  String?                @map("dispute_document_name")
  disputeUploadedAt    DateTime?              @map("dispute_uploaded_at")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?              @map("deleted_at")
  authorisations       PaymentAuthorisation[]
  receipt              PaymentReceipt?
  failedTransactions   FailedTransaction[]
  receiverBankDetails  ReceiverBankDetails?

  @@map("payment_case")
}

model PaymentAuthorisation {
  id            String      @id @default(uuid())
  paymentCase   PaymentCase @relation(fields: [paymentCaseId], references: [id])
  paymentCaseId String
  adminId       String
  action        String
  reason        String?
  // Cycle this signature belongs to (FR-020): SoD checks scope to the active cycle.
  cycle         Int         @default(1)
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?   @map("deleted_at")

  @@map("payment_authorisation")
}

model PaymentReceipt {
  id                  String      @id @default(uuid())
  paymentCase         PaymentCase @relation(fields: [paymentCaseId], references: [id])
  paymentCaseId       String      @unique
  bankReferenceNumber String
  // Binary SHA-256 of the canonical receipt PDF generated once at
  // TRANSFER_SUCCEED (FR-019): matches the downloaded file byte-for-byte.
  documentHash        String?
  documentPath        String?
  generatedAt         DateTime    @default(now())
  deletedAt           DateTime?   @map("deleted_at")

  @@map("payment_receipt")
}

model FailedTransaction {
  id            String      @id @default(uuid())
  paymentCase   PaymentCase @relation(fields: [paymentCaseId], references: [id])
  paymentCaseId String
  errorLog      String
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?   @map("deleted_at")

  @@map("failed_transaction")
}

model ReceiverBankDetails {
  id                   String      @id @default(uuid())
  bankName             String
  accountNumber        String
  accountHolderName    String
  phoneNumber          String
  myKadNumber          String
  encryptedBankDetails String
  paymentCaseId        String      @unique
  paymentCase          PaymentCase @relation(fields: [paymentCaseId], references: [id])
  deletedAt            DateTime?   @map("deleted_at")

  @@map("receiver_bank_details")
}

/// FR-016: the member's persisted default payout bank account. Saved either by
/// the first per-case bank submission (flow 1) or manually in member settings
/// (flow 2). It is a preference record only — it never submits anything to the
/// admin portal; GA sees bank details only after a per-case submission.
model MemberPayoutDetail {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id") @db.Uuid
  bankName          String
  accountNumber     String
  accountHolderName String
  phoneNumber       String
  myKadNumber       String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [userId])

  @@map("member_payout_detail")
}

enum FundingSource {
  GOVERNMENT
  PRIVATE
  OTHERS
}

model Project {
  projectId     String            @id @default(uuid()) @db.Uuid @map("project_id")
  projectName   String            @unique @db.VarChar(255) @map("project_name")
  projectType   String            @db.VarChar(100) @map("project_type")
  purpose       String
  budget        Decimal           @db.Decimal(20, 2)
  fundingSource FundingSource     @default(GOVERNMENT) @map("funding_source")
  cases         AcquisitionCase[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")
  createdById   String            @db.Uuid @map("created_by_id")
  createdBy     User              @relation("ProjectCreatedBy", fields: [createdById], references: [userId])

  @@map("project")
}

model AcquisitionCase {
  caseId              String               @id @db.VarChar(255) @map("case_id")
  projectId           String               @db.Uuid @map("project_id")
  caseTitle           String               @db.VarChar(255) @map("case_title")
  status              CaseStatus           @map("status")
  registrationDate    DateTime             @map("registration_date")
  remarks             String
  project             Project              @relation(fields: [projectId], references: [projectId])
  landParcel          LandParcel?          @relation("AcquisitionCaseToLandParcel")
  valuationReports    ValuationReport[]
  caseAssignments     CaseAssignment[]
  compensationReports CompensationReport[]
  offerLetters        OfferLetter[]
  caseDocuments       CaseDocument[]
  objections          Objection[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  createdById         String               @db.Uuid @map("created_by_id")
  createdBy           User                 @relation("CreatedCases", fields: [createdById], references: [userId])

  @@index([projectId])
  @@index([status])
  @@map("acquisition_case")
}

enum LandCategory {
  AGRICULTURE
  BUILDING
  INDUSTRY
}

enum TenureType {
  FREEHOLD
  LEASEHOLD
  MALAY_RESERVE
}

model LandParcel {
  landId          String          @id @default(uuid()) @db.Uuid @map("land_id")
  caseId          String          @unique @db.VarChar(255) @map("case_id")
  landTitleNo     String          @unique @db.VarChar(255) @map("land_title_no")
  lotNo           String          @db.VarChar(100) @map("lot_no")
  tempat          String?         @db.VarChar(255)
  mukim           String          @db.VarChar(255)
  district        String          @db.VarChar(255)
  state           String          @db.VarChar(100)
  area            Decimal         @db.Decimal(12, 2)
  areaUnit        AreaUnit        @map("area_unit")
  category        LandCategory    @default(AGRICULTURE) @map("category")
  tenureType      TenureType      @default(FREEHOLD) @map("tenure_type")
  acquisitionCase AcquisitionCase @relation("AcquisitionCaseToLandParcel", fields: [caseId], references: [caseId])
  ownerships      LandOwnership[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdById     String          @db.Uuid @map("created_by_id")
  createdBy       User            @relation("LandParcelCreatedBy", fields: [createdById], references: [userId])

  @@index([caseId])
  @@index([district])
  @@index([state])
  @@map("land_parcel")
}

enum OwnershipType {
  INDIVIDUAL_CITIZEN
  JOINT_OWNERSHIP
  CORPORATE_ENTITY
  ESTATE_OF_DECEASED
  TRUSTEE
}

model LandOwner {
  ownerId        String                @id @default(uuid()) @db.Uuid @map("owner_id")
  name           String                @db.VarChar(255)
  nric           String                @db.VarChar(100)
  address        String
  contact        String                @db.VarChar(100)
  email          String?               @db.VarChar(255)
  ownerships     LandOwnership[]
  offerResponses OfferMemberResponse[]
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  createdById    String                @db.Uuid @map("created_by_id")
  createdBy      User                  @relation("LandOwnerCreatedBy", fields: [createdById], references: [userId])

  @@map("land_owner")
}

model LandOwnership {
  ownershipId    String        @id @default(uuid()) @db.Uuid @map("ownership_id")
  landId         String        @db.Uuid @map("land_id")
  ownerId        String        @db.Uuid @map("owner_id")
  ownershipType  OwnershipType @default(INDIVIDUAL_CITIZEN) @map("ownership_type")
  share          String?       @db.VarChar(50) @map("share")
  ownershipStart DateTime?     @map("ownership_start")
  ownershipEnd   DateTime?     @map("ownership_end")
  isCurrent      Boolean       @default(true) @map("is_current")
  landParcel     LandParcel    @relation(fields: [landId], references: [landId])
  landOwner      LandOwner     @relation(fields: [ownerId], references: [ownerId])
  offerLetters   OfferLetter[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  createdById    String        @db.Uuid @map("created_by_id")
  createdBy      User          @relation("LandOwnershipCreatedBy", fields: [createdById], references: [userId])

  @@index([landId])
  @@index([ownerId])
  @@map("land_ownership")
}

model CaseDocument {
  documentId      String          @id @default(uuid()) @db.Uuid @map("document_id")
  caseId          String          @db.VarChar(255) @map("case_id")
  documentType    String          @db.VarChar(100) @map("document_type")
  fileName        String          @db.VarChar(255) @map("file_name")
  fileSize        Int             @map("file_size")
  filePath        String          @db.VarChar(500) @map("file_path")
  mimeType        String          @db.VarChar(100) @map("mime_type")
  checksum        String          @db.VarChar(255) @map("checksum")
  acquisitionCase AcquisitionCase @relation(fields: [caseId], references: [caseId])
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdById     String          @db.Uuid @map("created_by_id")
  createdBy       User            @relation(fields: [createdById], references: [userId])

  @@index([caseId])
  @@map("case_document")
}

model ValuationReport {
  reportId                   String               @id @default(uuid()) @db.Uuid @map("report_id")
  caseId                     String               @db.VarChar(255) @map("case_id")
  valuerId                   String               @db.Uuid @map("valuer_id")
  valuationDate              DateTime?            @map("valuation_date")
  valuationMethod            String?              @db.VarChar(100) @map("valuation_method")
  locationType               String?              @db.VarChar(100) @map("location_type")
  buildingAge                Int?                 @map("building_age")
  landArea                   Decimal?             @db.Decimal(12, 2) @map("land_area")
  acquisitionArea            Decimal?             @db.Decimal(12, 2) @map("acquisition_area")
  builtUpArea                Decimal?             @db.Decimal(12, 2) @map("built_up_area")
  marketRatePerSqMeter       Decimal?             @db.Decimal(20, 2) @map("market_rate_per_sqm")
  compensationRatePerSqMeter Decimal?             @db.Decimal(20, 2) @map("compensation_rate_per_sqm")
  aiValuationPrice           Decimal?             @db.Decimal(20, 2) @map("ai_valuation_price")
  marketValue                Decimal?             @db.Decimal(20, 2) @map("market_value")
  recommendedCompensation    Decimal?             @db.Decimal(20, 2) @map("recommended_compensation")
  remarks                    String?
  reportStatus               ReportStatus?        @map("report_status")
  acquisitionCase            AcquisitionCase      @relation(fields: [caseId], references: [caseId])
  valuer                     User                 @relation("Valuer", fields: [valuerId], references: [userId])
  compensationReports        CompensationReport[]
  caseAssignments            CaseAssignment[]
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")
  deletedAt                  DateTime?            @map("deleted_at")
  createdById                String               @db.Uuid @map("created_by_id")
  createdBy                  User                 @relation("CreatedValuationReport", fields: [createdById], references: [userId])

  @@index([caseId])
  @@index([valuerId])
  @@index([reportStatus])
  @@map("valuation_report")
}

model CaseAssignment {
  assignmentId      String           @id @default(uuid()) @db.Uuid @map("assignment_id")
  caseId            String           @db.VarChar(255) @map("case_id")
  assignedToId      String           @db.Uuid @map("assigned_to_id")
  assignmentDate    DateTime         @map("assignment_date")
  dueDate           DateTime         @map("due_date")
  remarks           String?
  acquisitionCase   AcquisitionCase  @relation(fields: [caseId], references: [caseId])
  assignedTo        User             @relation("AssignedToUser", fields: [assignedToId], references: [userId])
  valuationReportId String?          @db.Uuid @map("valuation_report_id")
  valuationReport   ValuationReport? @relation(fields: [valuationReportId], references: [reportId])
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")
  createdById       String           @db.Uuid @map("created_by_id")
  createdBy         User             @relation("AssignedByUser", fields: [createdById], references: [userId])

  @@map("case_assignment")
}

model CompensationReport {
  compensationReportId    String          @id @default(uuid()) @db.Uuid @map("compensation_report_id")
  caseId                  String          @db.VarChar(255) @map("case_id")
  valuationReportId       String          @db.Uuid @map("valuation_report_id")
  reviewedById            String?         @db.Uuid @map("reviewed_by_id")
  approvedById            String?         @db.Uuid @map("approved_by_id")
  approvedAt              DateTime?       @map("approved_at")
  landValue               Decimal?        @db.Decimal(20, 2) @map("land_value")
  buildingValue           Decimal?        @db.Decimal(20, 2) @map("building_value")
  cropValue               Decimal?        @db.Decimal(20, 2) @map("crop_value")
  businessDisruption      Decimal?        @db.Decimal(20, 2) @map("business_disruption")
  disturbanceCompensation Decimal?        @db.Decimal(20, 2) @map("disturbance_compensation")
  relocationAllowance     Decimal?        @db.Decimal(20, 2) @map("relocation_allowance")
  otherEligible           Decimal?        @db.Decimal(20, 2) @map("other_eligible")
  totalCompensation       Decimal?        @db.Decimal(20, 2) @map("total_compensation")
  remarks                 String?
  status                  ReportStatus    @map("status")
  acquisitionCase         AcquisitionCase @relation(fields: [caseId], references: [caseId])
  valuationReport         ValuationReport @relation(fields: [valuationReportId], references: [reportId])
  reviewedBy              User?           @relation("ReviewedByUser", fields: [reviewedById], references: [userId])
  approvedBy              User?           @relation("ApprovedByUser", fields: [approvedById], references: [userId])
  offerLetters            OfferLetter[]
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  deletedAt               DateTime?       @map("deleted_at")
  createdById             String          @db.Uuid @map("created_by_id")
  createdBy               User            @relation("PreparedByUser", fields: [createdById], references: [userId])

  @@index([caseId])
  @@index([status])
  @@map("compensation_report")
}

model OfferLetter {
  offerId              String             @id @default(uuid()) @db.Uuid @map("offer_id")
  compensationReportId String             @db.Uuid @map("compensation_report_id")
  caseId               String             @db.VarChar(255) @map("case_id")
  ownershipId          String             @db.Uuid @map("ownership_id")
  offerReferenceNo     String             @unique @db.VarChar(255) @map("offer_reference_no")
  offerType            String             @db.VarChar(100) @map("offer_type")
  offerAmount          Decimal            @db.Decimal(20, 2) @map("offer_amount")
  offerDate            DateTime           @map("offer_date")
  expiryDate           DateTime           @map("expiry_date")
  acceptancePeriodDays Int                @map("acceptance_period_days")
  status               OfferStatus        @map("status")
  acceptedAt           DateTime?          @map("accepted_at")
  rejectedAt           DateTime?          @map("rejected_at")
  signedDocument       String?            @map("signed_document")
  blockchainHash       String?            @db.VarChar(255) @map("blockchain_hash")
  remarks              String?
  compensationReport   CompensationReport @relation(fields: [compensationReportId], references: [compensationReportId])
  acquisitionCase      AcquisitionCase    @relation(fields: [caseId], references: [caseId])
  landOwnership        LandOwnership      @relation(fields: [ownershipId], references: [ownershipId])
  objections           Objection[]
  memberResponses      OfferMemberResponse[]
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  createdById          String             @db.Uuid @map("created_by_id")
  createdBy            User               @relation("OfferLetterCreatedBy", fields: [createdById], references: [userId])

  @@index([caseId])
  @@index([ownershipId])
  @@index([status])
  @@map("offer_letter")
}

model OfferMemberResponse {
  responseId     String      @id @default(uuid()) @db.Uuid @map("response_id")
  offerId        String      @db.Uuid @map("offer_id")
  ownerId        String      @db.Uuid @map("owner_id")
  status         OfferStatus @map("status")
  remarks        String?     @map("remarks")
  signedDocument String?     @map("signed_document")
  respondedAt    DateTime    @default(now()) @map("responded_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  offerLetter    OfferLetter @relation(fields: [offerId], references: [offerId], onDelete: Cascade)
  landOwner      LandOwner   @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)

  @@unique([offerId, ownerId])
  @@map("offer_member_response")
}

model Objection {
  objectionId         String              @id @default(uuid()) @db.Uuid @map("objection_id")
  offerId             String              @db.Uuid @map("offer_id")
  caseId              String              @db.VarChar(255) @map("case_id")
  objectionReason     String              @map("objection_reason")
  requestedAmount     Decimal             @db.Decimal(20, 2) @map("requested_amount")
  status              ObjectionStatus     @map("status")
  reviewedById        String?             @db.Uuid @map("reviewed_by_id")
  reviewDate          DateTime?           @map("review_date")
  reviewRemarks       String?             @map("review_remarks")
  decision            Decision?           @map("decision")
  revisedCompensation Decimal?            @db.Decimal(20, 2) @map("revised_compensation")
  resolutionDate      DateTime?           @map("resolution_date")
  offerLetter         OfferLetter         @relation(fields: [offerId], references: [offerId])
  acquisitionCase     AcquisitionCase     @relation(fields: [caseId], references: [caseId])
  reviewedBy          User?               @relation("ReviewedByUser", fields: [reviewedById], references: [userId])
  objectionDocuments  ObjectionDocument[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")
  createdById         String              @db.Uuid @map("created_by_id")
  createdBy           User                @relation("SubmittedByUser", fields: [createdById], references: [userId])

  @@index([caseId])
  @@index([status])
  @@map("objection")
}

model ObjectionDocument {
  documentId  String    @id @default(uuid()) @db.Uuid @map("document_id")
  objectionId String    @db.Uuid @map("objection_id")
  fileName    String    @db.VarChar(255) @map("file_name")
  filePath    String    @db.VarChar(500) @map("file_path")
  mimeType    String    @db.VarChar(100) @map("mime_type")
  checksum    String    @db.VarChar(255) @map("checksum")
  objection   Objection @relation(fields: [objectionId], references: [objectionId])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String    @db.Uuid @map("created_by_id")
  createdBy   User      @relation(fields: [createdById], references: [userId])

  @@map("objection_document")
}

model User {
  userId               String    @id @default(uuid()) @db.Uuid @map("user_id")
  name                 String    @db.VarChar(255)
  email                String    @unique @db.VarChar(255)
  contactNumber        String    @db.VarChar(100) @map("contact_number")
  identificationNumber String    @db.VarChar(100) @map("identification_number")
  passwordHash         String    @map("password_hash")
  role                 UserRole
  isActive             Boolean   @default(true) @map("is_active")
  profilePictureUrl    String?   @map("profile_picture_url")
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")
  mfaSecret            String?   @map("mfa_secret")
  lastLoginAt          DateTime? @map("last_login_at")

  createdProjects         Project[]             @relation("ProjectCreatedBy")
  createdCases            AcquisitionCase[]     @relation("CreatedCases")
  createdLandParcels      LandParcel[]          @relation("LandParcelCreatedBy")
  createdLandOwners       LandOwner[]           @relation("LandOwnerCreatedBy")
  createdOwnerships       LandOwnership[]       @relation("LandOwnershipCreatedBy")
  assignedToCases         CaseAssignment[]      @relation("AssignedToUser")
  assignedByCases         CaseAssignment[]      @relation("AssignedByUser")
  valuerReports           ValuationReport[]     @relation("Valuer")
  createdValuationReports ValuationReport[]     @relation("CreatedValuationReport")
  preparedReports         CompensationReport[]  @relation("PreparedByUser")
  reviewedReports         CompensationReport[]  @relation("ReviewedByUser")
  approvedReports         CompensationReport[]  @relation("ApprovedByUser")
  submittedObjections     Objection[]           @relation("SubmittedByUser")
  reviewedObjections      Objection[]           @relation("ReviewedByUser")
  createdOfferLetters     OfferLetter[]         @relation("OfferLetterCreatedBy")
  caseDocuments           CaseDocument[]
  objectionDocuments      ObjectionDocument[]

  sessions                UserSession[]
  passwordResets          PasswordReset[]
  accountActivations      AccountActivation[]
  auditLogs               AuditLog[]
  alerts                  SystemAlert[]
  createdEmailTemplates   EmailTemplate[]
  payoutDetail            MemberPayoutDetail?

  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  deletedAt               DateTime?             @map("deleted_at")

  @@unique([contactNumber, role])
  @@unique([identificationNumber, role])
  @@map("user")
}

model UserSession {
  sessionId    String   @id @default(uuid()) @db.Uuid @map("session_id")
  userId       String   @db.Uuid @map("user_id")
  sessionToken String   @unique @db.VarChar(255) @map("session_token")
  ipAddress    String   @db.VarChar(45) @map("ip_address")
  deviceInfo   String?  @map("device_info")
  lastActivity DateTime @default(now()) @map("last_activity")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}

model PasswordReset {
  resetId    String   @id @default(uuid()) @db.Uuid @map("reset_id")
  userId     String   @db.Uuid @map("user_id")
  resetToken String   @unique @db.VarChar(255) @map("reset_token")
  expiresAt  DateTime @map("expires_at")
  isUsed     Boolean  @default(false) @map("is_used")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset")
}

model AccountActivation {
  activationId String   @id @default(uuid()) @db.Uuid @map("activation_id")
  userId       String   @db.Uuid @map("user_id")
  token        String   @unique @db.VarChar(255)
  expiresAt    DateTime @map("expires_at")
  isUsed       Boolean  @default(false) @map("is_used")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("account_activation")
}

model AuditLog {
  logId           String   @id @default(uuid()) @db.Uuid @map("log_id")
  userId          String?  @db.Uuid @map("user_id")
  userRole        String?  @db.VarChar(100) @map("user_role")
  activityType    String   @db.VarChar(100) @map("activity_type")
  moduleName      String   @db.VarChar(100) @map("module_name")
  caseReference   String?  @db.VarChar(255) @map("case_reference")
  ipAddress       String   @db.VarChar(45) @map("ip_address")
  deviceInfo      String?  @map("device_info")
  activityDetails String?  @map("activity_details")
  systemResponse  String?  @map("system_response")
  isArchived      Boolean  @default(false) @map("is_archived")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User?    @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([activityType])
  @@index([moduleName])
  @@index([caseReference])
  @@index([createdAt])
  @@map("audit_log")
}

model SystemAlert {
  alertId        String       @id @default(uuid()) @db.Uuid @map("alert_id")
  recipientId    String       @db.Uuid @map("recipient_id")
  alertType      String       @db.VarChar(100) @map("alert_type")
  channel        AlertChannel @map("channel")
  urgencyLevel   AlertUrgency @default(MEDIUM) @map("urgency_level")
  caseReference  String?      @db.VarChar(255) @map("case_reference")
  message        String
  isAcknowledged Boolean      @default(false) @map("is_acknowledged")
  acknowledgedAt DateTime?    @map("acknowledged_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  recipient      User         @relation(fields: [recipientId], references: [userId], onDelete: Cascade)

  @@index([recipientId])
  @@index([isAcknowledged])
  @@map("system_alert")
}

model ProcessDeadline {
  deadlineId    String         @id @default(uuid()) @db.Uuid @map("deadline_id")
  caseReference String         @db.VarChar(255) @map("case_reference")
  processType   String         @db.VarChar(100) @map("process_type")
  issuanceDate  DateTime       @map("issuance_date")
  dueDate       DateTime       @map("due_date")
  status        DeadlineStatus @default(PENDING) @map("status")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([caseReference])
  @@index([status])
  @@map("process_deadline")
}

model EmailTemplate {
  templateId   String   @id @default(uuid()) @db.Uuid @map("template_id")
  templateName String   @unique @db.VarChar(100) @map("template_name")
  subject      String   @db.VarChar(255)
  bodyContent  String   @map("body_content")
  createdById  String   @db.Uuid @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdBy    User     @relation(fields: [createdById], references: [userId])

  @@map("email_template")
}

model SystemMetric {
  metricId            String   @id @default(uuid()) @db.Uuid @map("metric_id")
  uptimeSeconds       BigInt   @map("uptime_seconds")
  averageResponseTime Decimal  @db.Decimal(10, 2) @map("average_response_time")
  peakUsagePeriod     String?  @db.VarChar(100) @map("peak_usage_period")
  transactionVolume   Int      @map("transaction_volume")
  errorRate           Decimal  @db.Decimal(5, 2) @map("error_rate")
  resourceUtilisation String?  @map("resource_utilisation")
  recordedAt          DateTime @default(now()) @map("recorded_at")

  @@index([recordedAt])
  @@map("system_metric")
}

model ComplianceBackupLog {
  logId     String   @id @default(uuid()) @db.Uuid @map("log_id")
  logType   LogType  @map("log_type")
  status    String   @db.VarChar(50)
  details   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([logType])
  @@map("compliance_backup_log")
}