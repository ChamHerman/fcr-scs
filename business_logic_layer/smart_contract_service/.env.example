DATABASE_URL=postgresql://fcr_app:postgres@localhost:5432/fcr_scs?schema=public
ADMIN_WALLET_ADDRESS=0xYOUR_ADMIN_WALLET
# Publish/void transactions are signed by the admin wallet in MetaMask — the
# service never holds a private key and only verifies receipts on-chain.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
CONTRACT_ADDRESS=0xDEPLOYED_CONTRACT_ADDRESS
# Optional — runtime network switching (admin Settings page). Defaults to sepolia.
# ACTIVE_NETWORK=sepolia|mainnet
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# MAINNET_CONTRACT_ADDRESS=0xDEPLOYED_MAINNET_CONTRACT
