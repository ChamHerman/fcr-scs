# ==============================================================================
# FCR-SCS Unified Monorepo Environment Configuration Template
# Copy this file to .env at the root of the repository: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL & Prisma ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=[SCHEMA]
DATABASE_URL="postgresql://fcr_app:postgres@localhost:5432/fcr_scs?schema=public"

# ------------------------------------------------------------------------------
# 2. Unified Backend Server (Modular Monolith - Express.js)
# ------------------------------------------------------------------------------
PORT=3030
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Smart Contract & Blockchain (Ethereum / Sepolia Testnet)
# ------------------------------------------------------------------------------
ACTIVE_NETWORK=sepolia
# Ethereum Sepolia RPC URL (Infura, Alchemy, or PublicNode)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_OR_ALCHEMY_API_KEY
# Deployer private key for server-side transactions (without 0x prefix)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_hex
# Deployed FCRSCSLedger contract address on Sepolia
CONTRACT_ADDRESS=0x5539d016e1A4Bd1e51d17D976D1ff05cb452B428
SEPOLIA_CONTRACT_ADDRESS=0x5539d016e1A4Bd1e51d17D976D1ff05cb452B428
# Government Administrator wallet address authorized to publish records
ADMIN_WALLET_ADDRESS=0x8F66b4902858b8Dc6cb1bdD4C3cF040101CcC409

# ------------------------------------------------------------------------------
# 4. Frontend Application (Vite / React 19)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3030
VITE_API_URL=http://localhost:3030/api
VITE_ADMIN_WALLET_ADDRESS=0x8F66b4902858b8Dc6cb1bdD4C3cF040101CcC409
VITE_CONTRACT_ADDRESS=0x5539d016e1A4Bd1e51d17D976D1ff05cb452B428

# ------------------------------------------------------------------------------
# 5. AI Valuation Sidecar (Python / Flask, port 5001)
#    Unified server dials AI_SERVICE_URL; sidecar binds to AI_SERVICE_PORT.
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:5001
AI_SERVICE_PORT=5001

# ------------------------------------------------------------------------------
# 6. Email / SMTP Notifications (Nodemailer - OTP & Password Reset)
# ------------------------------------------------------------------------------
# Gmail / SMTP credentials for transactional emails and 2FA OTP codes
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FCR-SCS System <noreply@fcrscs.gov.my>"
# Optional: reroutes all outgoing emails to this address during local testing
ADMIN_EMAIL_OVERRIDE=""
